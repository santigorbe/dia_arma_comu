# Local service URLs
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
# Docker Compose reads this root file for the backend, workers, database initialization, and frontend build.
# Do not add VITE_* variables here: Compose derives the public Vite build variables below from their private runtime counterparts.
BACKEND_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:5173

# PostgreSQL
# These values are required even when DATABASE_URL is set. Keep all four values aligned.
POSTGRES_DB=communications_day
POSTGRES_USER=communications_day
POSTGRES_PASSWORD=local-development-password
# Under Compose, the database host is the `postgres` service, never localhost.
DATABASE_URL=postgres://communications_day:local-development-password@postgres:5432/communications_day

# Cookies and JWTs: replace in any non-local environment
JWT_SECRET=replace-with-a-long-random-secret-before-use
AUTH_COOKIE_NAME=communications_day_admin
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_MAX_AGE_SECONDS=3600

# Consent and retention policy placeholders
ACTIVE_CONSENT_VERSION=consent-local-placeholder
CONSENT_TEXT=Non-final local consent text. Operators must provide approved production text.
RETENTION_ANONYMOUS_VISIT_DAYS=30
RETENTION_REGISTRATION_DAYS=365
RETENTION_AUDIT_DAYS=2555
RETENTION_CERTIFICATE_DAYS=2555
RETENTION_COMMUNICATION_DAYS=365

# Provider modes default to deterministic simulation and require no credentials
EMAIL_PROVIDER_MODE=simulation
WHATSAPP_PROVIDER_MODE=simulation
BREVO_API_KEY=
BREVO_FROM_EMAIL=
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_SENDER_ID=
WHATSAPP_TEMPLATE_REGISTRATION=

# Public map and operator-supplied assets
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=OpenStreetMap contributors
ASSET_LOGO_PATH=
ASSET_CERTIFICATE_BACKGROUND_PATH=
